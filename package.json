{
  "name": "studysanctuary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:emulators": "tsx scripts/dev-with-emulators.ts",
    "demo": "tsx scripts/dev-with-emulators.ts --demo",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --outfile=dist/server.cjs --packages=external && cp package.json dist/",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:build": "node --import tsx --test tests/bundle/*.test.ts",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-studysanctuary --only auth,firestore,storage \"node --import tsx --test --test-concurrency=1 tests/rules/*.test.ts\"",
    "scan:source": "tsx scripts/scan-secrets.ts --tracked",
    "scan:bundle": "tsx scripts/scan-secrets.ts dist",
    "verify:config": "tsx scripts/verify-config.ts",
    "verify": "npm run lint && npm test && npm run scan:source && npm run test:build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.13.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase": "^11.3.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "mercadopago": "^3.6.1",
    "multer": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.34.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "qs": "^6.16.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
