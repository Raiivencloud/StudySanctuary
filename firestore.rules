rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin = `admin` custom claim (scripts/ops/admin-claims.ts) or the legacy owner account
    // with a verified email. The `role` field of users/{uid} is NOT trusted: any user could
    // write it (audit C-03).
    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.get('admin', false) == true ||
          (request.auth.token.get('email', '').lower() == "agusgestro17@gmail.com" && request.auth.token.get('email_verified', false) == true)
        );
    }

    function isDocOwner() {
      return isAuthenticated() &&
             (
               (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) ||
               (resource != null && 'uid' in resource.data && request.auth.uid == resource.data.uid) ||
               (resource != null && 'authorId' in resource.data && request.auth.uid == resource.data.authorId)
             );
    }

    // The owner of a document cannot hand it over to another user.
    function keepsUserId() {
      return request.resource.data.get('userId', null) == resource.data.get('userId', null);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // "YYYY-MM-DD" equal to the current UTC date (same format as new Date().toISOString()).
    function isTodayUtc(value) {
      let parts = value.split('-');
      return value is string &&
             value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             int(parts[0]) == request.time.year() &&
             int(parts[1]) == request.time.month() &&
             int(parts[2]) == request.time.day();
    }

    // ---------------------------------------------------------------
    // Groups
    // ---------------------------------------------------------------
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
    }

    function isGroupCreator(groupId) {
      return isAuthenticated() && exists(groupPath(groupId)) && get(groupPath(groupId)).data.createdBy == request.auth.uid;
    }

    // The creator always counts as member/admin: groups created before this fix have no
    // admin membership document (the old rules rejected it).
    function isGroupMember(groupId) {
      return isAuthenticated() && (exists(memberPath(groupId)) || isGroupCreator(groupId));
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated() &&
        (isGroupCreator(groupId) || (exists(memberPath(groupId)) && get(memberPath(groupId)).data.role == 'admin'));
    }

    // ---------------------------------------------------------------
    // Credits, plans and roles (users/{uid})
    // ---------------------------------------------------------------
    // TRANSITIONAL (Phase 3A). The client still performs a few bounded credit transitions
    // (consume 1, daily refill to 5, one free trial). When server-side credits are deployed
    // together with the AI proxy (Phase 3B/4), this returns false and the client can no
    // longer write any economic field. See docs/CREDITS_SERVER_MODEL.md.
    function clientCreditTransitionsEnabled() {
      return true; // CLIENT_CREDIT_TRANSITIONS
    }

    function economicFields() {
      return ['role', 'remainingCredits', 'subscriptionType', 'hasUsedFreeTrial', 'lastCreditReset', 'subscription'];
    }

    function credits(data) {
      return data.get('remainingCredits', 0);
    }

    function validNewProfile(data) {
      return (!('role' in data) || data.role == 'user') &&
             (!('subscription' in data) || (data.subscription.status == 'trial' && data.subscription.type == 'free')) &&
             (!('hasUsedFreeTrial' in data) || data.hasUsedFreeTrial == false) &&
             !('lastCreditReset' in data) &&
             (!('subscriptionType' in data) || (clientCreditTransitionsEnabled() && data.subscriptionType == 'Gratis')) &&
             (!('remainingCredits' in data) ||
               (clientCreditTransitionsEnabled() && data.remainingCredits is int && data.remainingCredits >= 0 && data.remainingCredits <= 15));
    }

    // AuthContext marks an expired 7-day trial. Only a downgrade, allowed in every mode.
    function isTrialExpiry() {
      return onlyChanges(['subscription']) &&
             resource.data.subscription.status == 'trial' &&
             request.resource.data.subscription.diff(resource.data.subscription).affectedKeys().hasOnly(['status']) &&
             request.resource.data.subscription.status == 'expired';
    }

    // consumeCredit(): exactly one credit less.
    function isCreditConsumption() {
      return onlyChanges(['remainingCredits']) &&
             credits(resource.data) is int && credits(resource.data) > 0 &&
             request.resource.data.remainingCredits == credits(resource.data) - 1;
    }

    // getUserCredits(): once per UTC day, only when the balance is 0 or less, back to 5.
    function isDailyRefill() {
      return onlyChanges(['remainingCredits', 'lastCreditReset']) &&
             credits(resource.data) <= 0 &&
             request.resource.data.remainingCredits == 5 &&
             isTodayUtc(request.resource.data.lastCreditReset) &&
             resource.data.get('lastCreditReset', '') != request.resource.data.lastCreditReset;
    }

    // updateSubscription('prueba'): the free trial, once per account.
    function isFreeTrialActivation() {
      return changedKeys().hasOnly(['subscriptionType', 'remainingCredits', 'hasUsedFreeTrial']) &&
             resource.data.get('hasUsedFreeTrial', false) != true &&
             request.resource.data.hasUsedFreeTrial == true &&
             request.resource.data.subscriptionType == '7 DÍAS GRATIS' &&
             request.resource.data.remainingCredits == 15;
    }

    function isAllowedProfileUpdate() {
      return !changedKeys().hasAny(economicFields()) ||
             isTrialExpiry() ||
             (clientCreditTransitionsEnabled() && (isCreditConsumption() || isDailyRefill() || isFreeTrialActivation()));
    }

    // ---------------------------------------------------------------
    // Validators
    // ---------------------------------------------------------------
    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'courseId', 'createdBy', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.courseId is string &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('zoomUrl' in data) || (data.zoomUrl is string && data.zoomUrl.size() < 2048));
    }

    function isValidNote(data) {
      return data.keys().hasAll(['groupId', 'title', 'content', 'authorId', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() < 10000 &&
             data.authorId == request.auth.uid;
    }

    function isValidPlan(data) {
      return data.keys().hasAll(['groupId', 'title', 'steps', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.steps is list && data.steps.size() < 50;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() < 1000)) &&
             (!('type' in data) || (data.type is string && data.type.size() < 200)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() < 200)) &&
             (!('color' in data) || (data.color is string && data.color.size() < 200)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() < 100000)) &&
             (!('theory' in data) || (data.theory is string && data.theory.size() < 500000)) &&
             (!('examples' in data) || (data.examples is string && data.examples.size() < 200000)) &&
             (!('exercises' in data) || (data.exercises is string && data.exercises.size() < 200000)) &&
             (!('diagram' in data) || (data.diagram is string && data.diagram.size() < 200000)) &&
             (!('podcastScript' in data) || (data.podcastScript is string && data.podcastScript.size() < 200000)) &&
             (!('files' in data) || (data.files is list && data.files.size() < 200)) &&
             (!('exams' in data) || (data.exams is list && data.exams.size() < 100)) &&
             (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100)) &&
             (!('studyLevel' in data) || (data.studyLevel is string && data.studyLevel.size() < 200));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() < 100)) &&
             data.completed is bool;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'title', 'type', 'timestamp', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             data.type in ['flashcards', 'map', 'summary', 'plan', 'exam', 'exercises', 'diagram'] &&
             data.timestamp is number &&
             (data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidExam(data) {
      return data.keys().hasAll(['userId', 'title', 'type', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             (!('date' in data) || (data.date is string && data.date.size() < 100)) &&
             (!('time' in data) || (data.time is string && data.time.size() < 100)) &&
             (!('location' in data) || (data.location is string && data.location.size() < 500)) &&
             data.type in ['Primary', 'Secondary', 'Finals', 'Midterm', 'Quiz'] &&
             (!('tags' in data) || (data.tags is list && data.tags.size() < 20)) &&
             (!('reminder' in data) || data.reminder in ['none', '1h', '2h', '1d', '2d']) &&
             (!('color' in data) || (data.color is string && data.color.size() < 100));
    }

    function isValidUserFile(data) {
      return data.keys().hasAll(['userId', 'name', 'url', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
             data.url is string && data.url.size() > 0 && data.url.size() < 2048 &&
             (!('type' in data) || (data.type is string && data.type.size() < 100)) &&
             (!('size' in data) || (data.size is number && data.size >= 0));
    }

    function isValidBookProgress(data) {
      return data.keys().hasAll(['userId', 'bookId']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.bookId is string && data.bookId.size() > 0 &&
             (!('content' in data) || (data.content is list && data.content.size() < 1000)) &&
             (!('currentPage' in data) || (data.currentPage is number && data.currentPage >= 0));
    }

    // New feedback is always private; an admin publishes it after moderation.
    function isValidNewFeedback(data) {
      return data.userId == request.auth.uid &&
             data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'type', 'message', 'rating', 'createdAt', 'isPublic', 'publicCandidate']) &&
             data.get('isPublic', false) == false &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('userPhoto' in data) || data.userPhoto == null || data.userPhoto is string) &&
             (data.get('rating', null) == null || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
             (!('publicCandidate' in data) || data.publicCandidate is bool);
    }

    // ---------------------------------------------------------------
    // Arena (client-side game: these rules enforce the scoring formula used by ArenaView,
    // they cannot verify answers — see docs/FIRESTORE_SECURITY_3A.md)
    // ---------------------------------------------------------------
    function levels() {
      return ['Inicial', 'Secundario', 'Universidad', 'Master'];
    }

    function levelSum(data) {
      let lp = data.get('levelPoints', {});
      return lp.get('Inicial', 0) + lp.get('Secundario', 0) + lp.get('Universidad', 0) + lp.get('Master', 0);
    }

    function noLevelDecreases(before, after) {
      let a = before.get('levelPoints', {});
      let b = after.get('levelPoints', {});
      return b.get('Inicial', 0) >= a.get('Inicial', 0) && b.get('Secundario', 0) >= a.get('Secundario', 0) &&
             b.get('Universidad', 0) >= a.get('Universidad', 0) && b.get('Master', 0) >= a.get('Master', 0);
    }

    function isValidArenaStats(data) {
      return data.keys().hasAll(['userId', 'lives', 'maxLives', 'streak', 'maxStreak', 'credits', 'totalPoints']) &&
             data.userId == request.auth.uid &&
             data.lives is number &&
             data.maxLives is number &&
             data.streak is number &&
             data.maxStreak is number &&
             data.credits is number &&
             data.totalPoints is number;
    }

    function isNewArenaStats(data) {
      return isValidArenaStats(data) &&
             data.maxLives == 3 && data.lives == 3 && data.streak == 0 && data.maxStreak == 0 &&
             data.credits == 0 && data.totalPoints == 0 && levelSum(data) == 0 &&
             (!('levelPoints' in data) || data.levelPoints.keys().hasOnly(levels()));
    }

    // Correct answer: streak + 1 and exactly 10 + 2 x streak points, at most one per second.
    function isCorrectAnswer() {
      let before = resource.data;
      let after = request.resource.data;
      let earned = 10 + 2 * after.streak;
      return onlyChanges(['streak', 'maxStreak', 'totalPoints', 'levelPoints', 'lastAnsweredAt']) &&
             after.streak == before.streak + 1 &&
             ((after.streak > before.maxStreak && after.maxStreak == after.streak) ||
              (after.streak <= before.maxStreak && after.maxStreak == before.maxStreak)) &&
             after.totalPoints == before.totalPoints + earned &&
             after.levelPoints.keys().hasOnly(levels()) &&
             levelSum(after) == levelSum(before) + earned &&
             noLevelDecreases(before, after) &&
             after.lastAnsweredAt == request.time &&
             (!('lastAnsweredAt' in before) || request.time > before.lastAnsweredAt + duration.value(1, 's'));
    }

    // Wrong answer: one life less, streak back to 0 (cooldown only when lives reach 0).
    function isWrongAnswer() {
      let before = resource.data;
      let after = request.resource.data;
      return onlyChanges(['lives', 'streak', 'lastLifeLostAt', 'cooldownUntil']) &&
             before.lives > 0 && after.lives == before.lives - 1 && after.streak == 0 &&
             (after.lives == 0 || !changedKeys().hasAny(['cooldownUntil']));
    }

    // Lives restored after the cooldown or by paying a credit (not verifiable here).
    function isLivesRestore() {
      return onlyChanges(['lives', 'cooldownUntil']) &&
             resource.data.lives == 0 &&
             request.resource.data.lives == resource.data.maxLives &&
             request.resource.data.cooldownUntil == null;
    }

    // dropCollectible(): one more card id in the album.
    function isCollectibleAdded() {
      let before = resource.data.get('collectibles', []);
      let after = request.resource.data.collectibles;
      return onlyChanges(['collectibles']) && after is list &&
             after.size() == before.size() + 1 && after.hasAll(before);
    }

    function isValidRanking(data) {
      return data.keys().hasAll(['userId', 'displayName', 'photoURL', 'points', 'level', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.photoURL is string &&
             data.points is number &&
             data.level in levels() &&
             (data.updatedAt is timestamp || data.updatedAt is string) &&
             // The ranking must match the level points recorded in the user's own arena stats.
             data.points == get(/databases/$(database)/documents/arena_stats/$(request.auth.uid)).data.get('levelPoints', {}).get(data.level, 0);
    }

    function isValidCollectible(data) {
      return data.userId == request.auth.uid &&
             data.keys().hasOnly(['userId', 'name', 'rarity', 'imageUrl', 'description', 'unlockedAt']) &&
             data.rarity in ['Bronce', 'Plata', 'Oro', 'Fuego'] &&
             data.name is string && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048));
    }

    function isValidArenaQuestion(data) {
      return data.keys().hasAll(['question', 'options', 'correctAnswer', 'category', 'level']) &&
             data.keys().size() <= 12 &&
             data.question is string && data.question.size() <= 1000 &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 6 &&
             data.correctAnswer is int && data.correctAnswer >= 0 && data.correctAnswer < data.options.size() &&
             (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 2000)) &&
             data.category is string && data.category.size() <= 100 &&
             data.level in levels();
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validNewProfile(request.resource.data);
      allow update: if isOwner(userId) && isAllowedProfileUpdate();
      // Users can no longer delete their own profile (it reset credits and the free trial).
      allow delete: if isAdmin();

      // Private subcollections of the user. `creditLedger` is written only by the server.
      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && subcollection != 'creditLedger';
      }
    }

    // Payments (Phase 5): orders and Mercado Pago payment records are written and read only by
    // the server (Admin SDK). Users see their granted or revoked plans in users/{uid}/creditLedger.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }
    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Study Groups
    match /groups/{groupId} {
      // Allow any authenticated user to see groups to join
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && isValidGroup(request.resource.data) && request.resource.data.createdBy == request.auth.uid;

      // Admins (creator or admin members) update the group; the creator cannot change.
      allow update: if isGroupAdmin(groupId) && isValidGroup(request.resource.data) &&
                       request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isGroupAdmin(groupId);

      // Group Members
      match /members/{userId} {
        allow read: if isGroupMember(groupId);

        // Join as member; the creator joins as admin of their own group.
        allow create: if isOwner(userId) &&
                         request.resource.data.userId == request.auth.uid &&
                         (request.resource.data.role == 'member' ||
                          (request.resource.data.role == 'admin' && isGroupCreator(groupId)));

        // Admins promote members; members can only keep the 'member' role.
        allow update: if (isGroupAdmin(groupId) && request.resource.data.role in ['member', 'admin']) ||
                         (isOwner(userId) && request.resource.data.role == 'member');

        // Allow admin to remove members or members to leave
        allow delete: if isGroupAdmin(groupId) || isOwner(userId);
      }

      // Shared Notes
      match /notes/{noteId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && isValidNote(request.resource.data);
        allow update: if isGroupMember(groupId) && (request.auth.uid == resource.data.authorId || isGroupAdmin(groupId)) && isValidNote(request.resource.data);
        allow delete: if isGroupMember(groupId) && (request.auth.uid == resource.data.authorId || isGroupAdmin(groupId));
      }

      // Shared Study Plans
      match /plans/{planId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && isValidPlan(request.resource.data);
        allow update: if isGroupMember(groupId) && isValidPlan(request.resource.data);
        allow delete: if isGroupAdmin(groupId);
      }
    }

    // Feedback: private on creation, published only by an admin (moderation).
    match /feedback/{feedbackId} {
      allow read: if isAdmin() ||
                     (resource != null && resource.data.isPublic == true) ||
                     (isAuthenticated() && resource != null && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidNewFeedback(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // User Owned Data (Courses, Tasks, Activities, Exams, Chats)
    match /user_courses/{courseId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidCourse(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && isValidCourse(request.resource.data) && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || isDocOwner();

      match /content/{contentId} {
        // Allow access if the user owns the document OR if they own the parent course
        allow read, write: if isAdmin() || isDocOwner() ||
                             (isAuthenticated() && get(/databases/$(database)/documents/user_courses/$(courseId)).data.userId == request.auth.uid);
      }
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTask(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && keepsUserId() && isValidTask(request.resource.data));
      allow delete: if isAdmin() || isDocOwner();
    }

    match /activities/{activityId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidActivity(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && keepsUserId() && isValidActivity(request.resource.data));
      allow delete: if isAdmin() || isDocOwner();
    }

    match /exams/{examId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidExam(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && keepsUserId() && isValidExam(request.resource.data));
      allow delete: if isAdmin() || isDocOwner();
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isDocOwner() && keepsUserId());
      allow delete: if isAdmin() || isDocOwner();

      // Messages belong to the owner of the parent chat (VoiceAssistant deletes the
      // messages before the chat, so the parent still exists at that point).
      function ownsChat() {
        let chatPath = /databases/$(database)/documents/chats/$(chatId);
        return isAuthenticated() && exists(chatPath) && get(chatPath).data.userId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read, delete: if isAdmin() || ownsChat();
        allow create, update: if ownsChat() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
      }
    }

    match /userFiles/{fileId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidUserFile(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && keepsUserId() && isValidUserFile(request.resource.data));
      allow delete: if isAdmin() || isDocOwner();
    }

    match /bookProgress/{progressId} {
      allow read: if isAdmin() || isDocOwner() || (isAuthenticated() && resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidBookProgress(request.resource.data);
      allow update: if isAdmin() || (isDocOwner() && keepsUserId() && isValidBookProgress(request.resource.data));
      allow delete: if isAdmin() || isDocOwner();
    }

    // Global Stats (AI kill switch, usage counters): written by the server or an admin only.
    match /stats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Public Library
    match /publicLibrary/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Arena Sanctuary Rules
    match /arena_questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidArenaQuestion(request.resource.data); // AI generated questions
      allow update, delete: if isAdmin();
    }

    match /arena_stats/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isNewArenaStats(request.resource.data);
      allow update: if isOwner(userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.maxLives == resource.data.maxLives &&
                       request.resource.data.credits == resource.data.credits &&
                       (isCorrectAnswer() || isWrongAnswer() || isLivesRestore() || isCollectibleAdded());
      allow delete: if isAdmin();
    }

    match /arena_collectibles/{collectibleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCollectible(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /arena_rankings/{rankingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                              rankingId == request.resource.data.level + "_" + request.auth.uid &&
                              isValidRanking(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
