# =============================================================================
# StudySanctuary: variables de entorno
# Copiar a .env (nunca commitear .env) y completar. Detalle en docs/CONFIGURATION.md
# =============================================================================

# -----------------------------------------------------------------------------
# PÚBLICAS (cliente). Todo lo que empieza con VITE_ se incluye en el bundle del
# navegador y lo puede ver cualquiera. NUNCA poner secretos con prefijo VITE_.
# Se leen al compilar: si cambian, hay que volver a hacer `npm run build`.
# -----------------------------------------------------------------------------

# Configuración web de Firebase (Consola de Firebase > Configuración del proyecto > Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# ID de la base de Firestore. Vacío = "(default)". Si el proyecto usa una base
# con nombre (por ejemplo, la creada por AI Studio), DEBE indicarse aquí.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Solo desarrollo local (npm run dev:emulators): conecta la app a los emuladores de Firebase.
# NUNCA en un build de producción.
# VITE_USE_FIREBASE_EMULATORS=true

# Ya NO existe VITE_GEMINI_API_KEY: la IA pasa por el servidor (GEMINI_API_KEY, abajo).

# -----------------------------------------------------------------------------
# PRIVADAS (servidor). Solo las lee server.ts. En producción, usar Secret Manager.
# -----------------------------------------------------------------------------

# Entorno (Cloud Run: production)
NODE_ENV=development

# URL pública de la app, sin "/" final (se usa en los redirects de OAuth y en el webhook de Mercado Pago)
APP_URL=

# Firebase Admin. Las credenciales se toman de Application Default Credentials
# (cuenta de servicio de Cloud Run o `gcloud auth application-default login`).
# Si se omiten, se usan VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_STORAGE_BUCKET.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Base de Firestore del servidor. Vacío = "(default)" (comportamiento anterior).
# Ver docs/CONFIGURATION.md: debería coincidir con VITE_FIREBASE_FIRESTORE_DATABASE_ID.
FIREBASE_DATABASE_ID=

# Secreto de las cookies de sesión. OBLIGATORIO en producción (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Administradores: emails VERIFICADOS (separados por coma) con acceso a /api/admin/*.
# Alternativa recomendada: custom claim `admin: true` en Firebase Auth.
# Vacío = nadie es admin (el panel responde 403).
ADMIN_EMAILS=
# Clave adicional para /astra-core-admin (además de iniciar sesión como admin)
ADMIN_SECRET_KEY=

# Sesiones. En producción la cookie es Secure; SameSite por defecto "none" (iframe cross-site).
# Recomendado "lax" si la app no se usa dentro de un iframe de otro sitio.
SESSION_COOKIE_SAMESITE=
SESSION_MAX_AGE_HOURS=24
# Saltos de proxy de confianza (Cloud Run: 1; por defecto 1 en producción y 0 en desarrollo)
TRUST_PROXY=

# Límites
UPLOAD_MAX_BYTES=26214400
RATE_LIMIT_API_PER_MINUTE=300

# Content Security Policy: report-only (no bloquea, solo reporta) u off
CSP_MODE=report-only

# Reescribir el CORS del bucket (origen "*") en cada arranque, como antes. Desactivado por defecto.
STORAGE_CORS_ON_STARTUP=false

# IA en el servidor (/api/ai/generate): identidad, créditos transaccionales y límites.
# Desactivada por defecto. Ver docs/PHASE4_REPORT.md (orden de despliegue).
AI_PROXY_ENABLED=false
# gemini (API real, requiere GEMINI_API_KEY) | fake (respuestas simuladas, solo desarrollo)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Límites de uso por usuario
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENT_PER_USER=3
# Llamadas diarias de las herramientas incluidas sin costo (herramientas del curso, preguntas de Arena)
AI_INCLUDED_DAILY_QUOTA=60
# Reintentos/modelos de respaldo por solicitud y tiempo máximo por intento
AI_MAX_UPSTREAM_ATTEMPTS=4
AI_UPSTREAM_TIMEOUT_MS=90000

# Mercado Pago (Fase 5, docs/PHASE5_PAYMENTS.md). Sin token: pagos desactivados (503).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (panel de Mercado Pago > Tus integraciones > Webhooks). Obligatoria en producción.
MERCADOPAGO_WEBHOOK_SECRET=
# fake = Mercado Pago simulado para desarrollo (rechazado en producción). Vacío = según el token.
MERCADOPAGO_MODE=
# true solo para un entorno de prueba con credenciales de test: acepta pagos con live_mode=false.
MERCADOPAGO_ALLOW_TEST_PAYMENTS=

# Google Calendar & Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook Calendar OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Nota: SPOTIFY_CLIENT_ID/SECRET figuraban en la versión anterior de este archivo,
# pero ningún código los usa; se quitaron.
